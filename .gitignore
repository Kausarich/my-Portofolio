# Dependencies and package-manager state
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js and generated build output
/.next/
/out/
/build/
/dist/
next-env.d.ts
*.tsbuildinfo

# Tool caches
/.cache/
/.turbo/
.eslintcache

# Test output, screenshots, and browser reports
/coverage/
/.artifacts/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Logs and diagnostic dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
report.*.json
*.pid
*.pid.lock

# Secrets: keep only the safe configuration example in Git
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Private CMS content, local uploads, and generated owner credentials
/.data/
/.owner-access*.txt

# Local database files (keep Prisma schema and migrations tracked)
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-shm
/prisma/*.db-wal
/prisma/*.sqlite
/prisma/*.sqlite3

# Hosting metadata
/.vercel/
/.netlify/

# Operating-system and editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~
