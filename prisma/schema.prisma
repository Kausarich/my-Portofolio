generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// An atomic document preserves CMS ordering; fields are validated with Zod.
model PortfolioContent {
  id        String   @id @default("main")
  data      Json
  updatedAt DateTime @updatedAt
}
